# Copy to `.env.submit` and fill in. `.env.submit` is gitignored — never commit it.
#
# Do NOT use `wxt submit init` to generate this: its refresh-token step uses
# Google's out-of-band OAuth flow (redirect_uri=urn:ietf:wg:oauth:2.0:oob),
# which Google shut off in October 2022. That step always fails with
# "Error 400: invalid_request". Get the refresh token with the loopback flow
# instead: `npx chrome-webstore-upload-keys`. See CHROME_STORE_SETUP.md.

CHROME_EXTENSION_ID="molpfdakehebpkaecfdpndakphebjjpp"
CHROME_CLIENT_ID=""
CHROME_CLIENT_SECRET=""
CHROME_REFRESH_TOKEN=""

# "default" = public release channel, "trustedTesters" = internal prerelease.
CHROME_PUBLISH_TARGET="default"

# true = upload the zip but don't submit it for review or publish it.
CHROME_SKIP_SUBMIT_REVIEW=false
