# Copy to `.env.submit` and fill in. `.env.submit` is gitignored — never commit it.
#
# Chrome Web Store API v2, authenticated with a service account. v1.1 (client
# ID + client secret + refresh token) was shut down on 2026-10-15, and an unset
# CHROME_API_VERSION still defaults to it — keep the line below.
# See CHROME_STORE_SETUP.md.
#
# `npx wxt submit init` can generate this file, but only on Node 24+: on Node 22
# it crashes with "RegExp.escape is not a function" before writing anything.

CHROME_API_VERSION="v2"
CHROME_EXTENSION_ID="molpfdakehebpkaecfdpndakphebjjpp"

# From the dashboard URL: chrome.google.com/webstore/devconsole/<publisher-id>
CHROME_PUBLISHER_ID=""

# `client_email` and `private_key` from the service account's JSON key file.
# Paste the key between double quotes with its "\n" sequences kept as-is.
CHROME_SERVICE_ACCOUNT_CLIENT_EMAIL=""
CHROME_SERVICE_ACCOUNT_PRIVATE_KEY=""

# true = upload the zip but don't submit it for review or publish it.
CHROME_SKIP_SUBMIT_REVIEW=false

# true = cancel a review that's already pending instead of failing.
CHROME_CANCEL_PENDING=false

# Only for changes Google lets skip review; PinFlux's never qualify.
CHROME_SKIP_REVIEW=false

# DEFAULT_PUBLISH = publish as soon as review approves it.
# STAGED_PUBLISH = hold the approved version until you publish it by hand.
CHROME_PUBLISH_TYPE="DEFAULT_PUBLISH"

# Share of existing users who get the update (staged rollout), 0-100.
CHROME_DEPLOY_PERCENTAGE=100
